name: Extract PRIYO_CODEX_HOST ZIP

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  unzip:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Extract PRIYO_CODEX_HOST.zip
        run: |
          unzip -o PRIYO_CODEX_HOST.zip -d extracted
          cp -r extracted/* ./
          rm -rf extracted
          rm -f PRIYO_CODEX_HOST.zip

      - name: Commit extracted files
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add .
          git commit -m "Extract PRIYO_CODEX_HOST project" || echo "Nothing to commit"
          git push
